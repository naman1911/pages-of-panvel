rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in Google account whose email sits in /allowlist.
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // The member list. Add and remove people from the Firebase console:
    // Firestore → allowlist → Add document → Document ID = their email, lowercase.
    // The document can be empty; only its existence matters.
    match /allowlist/{email} {
      // Closed to the browser entirely. The app never reads this collection,
      // and member() above resolves it with exists(), which is a privileged
      // server-side lookup and is not subject to these rules.
      //
      // While read was open to any signed-in account, anyone on earth with a
      // Google login — member or not, since signing in is not itself gated —
      // could list the collection and walk off with every member's email.
      allow read, write: if false;
    }

    // Everything the circle shares lives in one document, so a page load
    // costs one read instead of one per book.
    match /circle/public {
      allow read: if member();
      allow write: if member()
        && request.resource.data.keys().hasOnly(['members', 'books', 'board'])
        && request.resource.data.books.size() < 3000
        && request.resource.data.board.size() <= 40;
    }

    // Private shelves. Only ever readable by their owner.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
